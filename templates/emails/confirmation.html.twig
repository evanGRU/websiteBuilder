<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            background-color: #ffffff;
            color: #101010;
            padding: 20px;
            font-family: "Poppins", sans-serif;
            font-weight: 400;
        }
        .container {
            background-color: #ffffff;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
            padding: 20px;
            max-width: 600px;
            margin: auto;
            border: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
        }
        .confirmation-container {
            display: flex;
            align-items: center;
            justify-content: center;
        }
        a.button {
            display: inline-block;
            background: #0D47A1;
            color: white;
            font-family: "Poppins", sans-serif;
            font-weight: 500;
            padding: 0.5em 1em;
            text-decoration: none;
            text-align: center;
        }
        a.button:hover {
            background: #2563c1;
            border: #0D47A1;
        }
        .expiration-line {
            font-size: 10px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Bienvenue chez Zynta!</h1>
        <p>Cliquez ici pour confirmer votre compte :</p>
        <div class="confirmation-container">
            <a class="button" href={{ verificationURL }}>Confirmer mon adresse email</a>
        </div>
        <p class="expiration-line">Ce lien expire le {{ expiresAt|date('d/m/Y H:i') }}.</p>
    </div>
</body>
</html>
